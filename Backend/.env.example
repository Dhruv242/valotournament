# Copy this file to `.env` for local development.
# In production these values come from the val-backend-secrets K8s Secret —
# never put real secrets in source control.

NODE_ENV=development
PORT=3000

# --- Auth ---
# Generate a fresh value with:  openssl rand -base64 64
JWT_SECRET=replace-with-a-long-random-string
ADMIN_USERNAME=skull_dk_up81

# --- CORS ---
# Comma-separated list of allowed origins. In dev you can leave it blank
# (any origin is allowed when NODE_ENV !== production).
FRONTEND_ORIGIN=https://val.dev.ap-south-1.metaecho.com

# --- Database ---
DB_HOST=localhost
DB_PORT=5432
DB_USER=val_dk
DB_PASSWORD=replace-with-strong-password
DB_NAME=val
# Set to "true" when connecting to RDS or any TLS-required Postgres.
DB_SSL=false

# --- Razorpay ---
RAZORPAY_KEY_ID=rzp_test_xxx
RAZORPAY_KEY_SECRET=replace-with-razorpay-secret
